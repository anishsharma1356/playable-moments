# Server-only. No secret goes into VITE_* or a public bundle.
NODE_ENV=development
APP_MODE=demo
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
API_INTERNAL_ORIGIN=http://localhost:3000
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
ALLOWED_BROADCASTER_ID=
TOKEN_ENCRYPTION_KEY_BASE64=
SESSION_SIGNING_KEY_BASE64=
VOTE_HMAC_KEY_BASE64=
DATA_DIR=./data
SQLITE_PATH=./data/playable-moments.sqlite
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_BYTES=524288000
MAX_SOURCE_DURATION_SECONDS=1200
MAX_SEGMENT_DURATION_SECONDS=120
MEDIA_WORKER_CONCURRENCY=1
FFMPEG_THREADS=2
MEDIA_JOB_TIMEOUT_SECONDS=600
MIN_FREE_DISK_BYTES=2147483648
MAX_PENDING_VOTE_EVENTS=5000
AUDIT_RETENTION_DAYS=7
REPLAY_SESSION_TTL_DAYS=7
# Real hosted mode requires HTTPS, explicit owner identity and complete secrets.
# A .env file containing these values is gitignored; only this template is committed.
